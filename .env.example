# Copiez ce fichier en .env (non versionné) puis changez le mot de passe :
#   cp .env.example .env
POSTGRES_DB=iasante
POSTGRES_USER=iasante
POSTGRES_PASSWORD=change-moi

# Port publié par le front (http://localhost:8080). FRONT_BIND=0.0.0.0 pour l'ouvrir au réseau.
FRONT_BIND=127.0.0.1
FRONT_PORT=8080

# Registre et version des images (CI : ghcr.io/<compte>, TAG = tag Git)
REGISTRY=ghcr.io/yaniszedira
TAG=latest
