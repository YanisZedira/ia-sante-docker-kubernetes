# Configuration nginx du microservice « front ».
# Fichier modèle : au démarrage, l'image nginx remplace ${BACK_URL} et ${NGINX_LOCAL_RESOLVERS}
# (envsubst) puis écrit le résultat dans /etc/nginx/conf.d/default.conf.

server_tokens off;

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Types MIME absents de mime.types : .mjs (moteur WebAssembly d'onnxruntime, chargé comme module ES,
    # refusé par le navigateur s'il arrive en application/octet-stream) et .dzi (lame OpenSeadragon)
    include /etc/nginx/mime.types;
    types {
        text/javascript mjs;
        application/xml dzi;
    }

    # Redirections relatives : l'adresse et le port du navigateur sont conservés
    # (port-forward, NodePort, Gateway...).
    absolute_redirect off;

    # Résolveur DNS lu dans /etc/resolv.conf (Docker : 127.0.0.11, Kubernetes : kube-dns).
    # Avec une variable, nginx résout le back à chaque requête : le front démarre même si le back n'existe pas encore.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml application/xml application/wasm;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Sonde de santé (HEALTHCHECK Docker, liveness/readiness Kubernetes)
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # API : /api/stats -> ${BACK_URL}/stats (le préfixe /api est retiré)
    location /api/ {
        set $back ${BACK_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $back;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        client_max_body_size 16k;
    }

    location = / {
        return 302 /ia-sante/;
    }

    # Fichiers produits par Vite avec une empreinte dans le nom : cache d'un an
    location /ia-sante/assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # Modèles ONNX, moteur WebAssembly, lame et images : gros fichiers stables
    location ~ ^/ia-sante/(model|ort|data)/ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri $uri/ $uri/index.html =404;
    }
}
